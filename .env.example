# EmailJS — PUBLIC identifiers only. The public key is safe to expose in the
# browser. NEVER put a private EmailJS key here. Copy this file to `.env`
# for local dev, and set the same variables in Vercel Project Settings.

REACT_APP_EMAILJS_SERVICE_ID=service_8mucvfn
REACT_APP_EMAILJS_TEMPLATE_ID=template_02ssqcc
REACT_APP_EMAILJS_PUBLIC_KEY=BHX1Ca4sSWoOpfmMq

# Optional: a SECOND template to auto-reply a confirmation to the patient.
# Leave blank until you create one in EmailJS. Do not invent an ID.
REACT_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID=
